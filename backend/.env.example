# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/campusfind

# Auth
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Email. For demo without SMTP, leave SMTP_HOST empty and emails will be logged in console + notificationLogs collection.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CampusFind <no-reply@campusfind.local>

# Default admin seed account
ADMIN_FULL_NAME=CampusFind Admin
ADMIN_EMAIL=admin@uregina.ca
ADMIN_PASSWORD=Admin12345
ADMIN_PHONE=306-585-4407
